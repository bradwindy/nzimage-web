{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nzimages-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "API", "service": "nzimages-api", "entrypoint": "ImageApi" }],
  // iolab.nz lapses on 2027-01-22. Remove the iolab.nz route before then.
  "routes": [
    { "pattern": "nzimages.windybank.net", "custom_domain": true },
    { "pattern": "nzimages.iolab.nz", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
